# Copy to .env.local and adjust.

# Superflats backend, including the /api prefix. Read on the server only.
SUPERFLATS_API_URL=https://api.superflats.in/api

# Public URL of this website (used for metadata, Open Graph and sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown on the forgot-password and help screens.
NEXT_PUBLIC_SUPPORT_EMAIL=support@superflats.in
